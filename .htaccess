# ==========================================================
# SmartMove Pro Assurances - .htaccess (Hostinger)
# ==========================================================

Options -Indexes
ServerSignature Off

# ---------- Pages d'erreur ----------
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ---------- Page d'accueil ----------
DirectoryIndex index.html

# ---------- HTTPS + domaine unique (sans www) ----------
<IfModule mod_rewrite.c>
RewriteEngine On

# Forcer HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://smartmovepro.fr%{REQUEST_URI} [L,R=301]

# Retirer www
RewriteCond %{HTTP_HOST} ^www\.smartmovepro\.fr$ [NC]
RewriteRule ^ https://smartmovepro.fr%{REQUEST_URI} [L,R=301]

# Accueil : /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# Protéger les fichiers sensibles
RewriteRule ^(\.git|\.env|\.htaccess|\.htpasswd) - [F,L]
</IfModule>

# ---------- Fichiers sensibles ----------
<FilesMatch "(^\.|\.(env|ini|log|sql|bak|old|swp|md|json|lock)$)">
    Require all denied
</FilesMatch>

# ---------- En-têtes de sécurité ----------
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
Header unset X-Powered-By

# Pages de remerciement et 404 : ne pas indexer
<FilesMatch "^(404|404_en|merci|merci_en)\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
</FilesMatch>
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

# ---------- Cache navigateur ----------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>